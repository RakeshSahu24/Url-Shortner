# Backend runtime environment
# Set to production when deploying the API.
NODE_ENV=development
# API port; local development defaults to 3000.
PORT=3000
# MongoDB connection string; use MongoDB Atlas in production.
MONGODB_URI=mongodb://localhost:27017/short-url
# Comma-separated frontend origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173

# Frontend build-time environment
# API base URL; use /api for the local Vite proxy or the deployed API origin.
VITE_API_BASE_URL=/api
# Public API origin used when displaying generated short URLs.
VITE_PUBLIC_BACKEND_URL=http://localhost:3000
